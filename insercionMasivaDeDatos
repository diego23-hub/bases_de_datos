ALTER PROCEDURE insercionMasiva
    @cantidadEstudiantes INT,
    @cantidadEstudiantexCarrera INT,
    @cantidadEstudiantexGrupo INT,
    @cantidadGrupos INT,
    @cantidadSalones INT,
    @cantidadSalonesxGrupo INT,
    @cantidadProfesores INT,
    @cantidadFacultades INT,
    @cantidadCarreras INT,
    @cantidadAsignaturas INT,
    @cantidadAsignaturasxCarrera INT
AS
BEGIN
    DECLARE  @maxFacultad INT = (SELECT ISNULL(MAX(idFacultad),0) FROM FACULTAD);
    DECLARE @contador INT=0;

    WHILE @contador<@cantidadFacultades
    BEGIN   
        INSERT INTO FACULTAD(nombre) VALUES(
        CONCAT('Facultad_', (@maxFacultad + @contador+1)));
        SET @contador=@contador +1
    END

    DECLARE  @maxCarrera INT = (SELECT ISNULL(MAX(idCarrera),0) FROM CARRERAS);

    SET @contador = 0;
    WHILE @contador<@cantidadCarreras
    BEGIN   
        INSERT INTO CARRERAS (nombre, idFacultad) VALUES(
        CONCAT('Carrera_', (@maxCarrera + @contador+1)),
        (SELECT TOP 1 idFacultad FROM FACULTAD ORDER BY NEWID())
        );
        SET @contador=@contador +1
    END

    DECLARE  @maxAsignatura INT = (SELECT ISNULL(MAX(idAsignatura),0) FROM ASIGNATURAS);

    SET @contador= 0;
    WHILE @contador<@cantidadAsignaturas
    BEGIN   
        INSERT INTO ASIGNATURAS (nombreAsignatura) VALUES(
        CONCAT('Asignatura_', (@maxAsignatura + @contador+1)));
        SET @contador=@contador +1;
    END 

    DECLARE @maxAsignaturaxCarrera INT = (SELECT ISNULL(MAX(idAsignaturaxCarrera),0)FROM ASIGNATURAXCARRERA);

    SET @contador=0;
    WHILE @contador<@cantidadAsignaturasxCarrera
    BEGIN
        INSERT INTO ASIGNATURAXCARRERA (idCarrera,idAsignatura) VALUES(
        (SELECT TOP 1 idCarrera FROM CARRERAS ORDER BY NEWID()),
        (SELECT TOP 1 idAsignatura FROM ASIGNATURAS ORDER BY NEWID())
        );
        SET @contador=@contador+1
    END

    DECLARE  @maxSalon INT = (SELECT ISNULL(MAX(idSalon),0) FROM SALONES);

    SET @contador = 0;
    WHILE @contador<@cantidadSalones
    BEGIN   
        INSERT INTO SALONES (descripcion) VALUES(
        CONCAT('Salones', (@maxSalon + @contador+1)));

        SET @contador=@contador +1
    END

        BEGIN
        CREATE TABLE #Nombres
        (
            Nombre VARCHAR(100)
        );
        INSERT INTO #Nombres (Nombre) VALUES
        ('Juan'), ('Pedro'), ('Ana'), ('Santiago'), ('Miguel'),
        ('Sebastián'), ('Carlos'), ('Laura'), ('Valentina'), ('Camila'),
        ('Mateo'), ('Alejandro'), ('Diego'), ('Andrés'), ('Felipe'),
        ('Sofía'), ('Isabella'), ('Mariana'), ('Valeria'), ('Daniela'),
        ('Luis'), ('Gabriel'), ('Jorge'), ('Ricardo'), ('Fernando'),
        ('Lucía'), ('Carolina'), ('Paula'), ('Andrea'), ('Natalia');

        CREATE TABLE #Apellidos
        (
            Apellido VARCHAR(100)
        );
        INSERT INTO #Apellidos (Apellido) VALUES
        ('López'), ('Gil'), ('Martínez'), ('Restrepo'), ('Moreno'),
        ('Rodríguez'), ('Pérez'), ('Gómez'), ('González'), ('Hernández'),
        ('Sánchez'), ('Ramírez'), ('Cruz'), ('Morales'), ('Ortiz'),
        ('Gutiérrez'), ('Ruiz'), ('Álvarez'), ('Fernández'), ('Jiménez'),
        ('Vargas'), ('Rojas'), ('Acosta'), ('Medina'), ('Herrera'),
        ('Castro'), ('Silva'), ('Romero'), ('Suárez'), ('Quintero');

        INSERT INTO ESTUDIANTES (primerNombre,segundoNombre,primerApellido,segundoApellido, codigoTipoDocumento, numeroDocumento)
        SELECT TOP (@cantidadEstudiantes)
            n1.Nombre as primerNombre,
            n2.Nombre as segundoNombre,
            a1.Apellido as primerApellido,
            a2.Apellido as segundoApellido,
            1 AS codigoTipoDocumento, 
            CAST(ABS(CHECKSUM(NEWID())) AS VARCHAR(15)) AS numeroDocumento
        FROM #Nombres n1
        CROSS JOIN #Nombres n2
        CROSS JOIN #Apellidos a1
        CROSS JOIN #Apellidos a2
        ORDER BY NEWID();

        INSERT INTO PROFESORES (primerNombre,segundoNombre,primerApellido,segundoApellido, telefono)
        SELECT TOP (@cantidadProfesores)
            n1.Nombre as primerNombre,
            n2.Nombre as segundoNombre,
            a1.Apellido as primerApellido,
            a2.Apellido as segundoApellido,
            CONCAT('3', ABS(CHECKSUM(NEWID())) % 900000000 + 100000000) as telefono
        FROM #Nombres n1
        CROSS JOIN #Nombres n2
        CROSS JOIN #Apellidos a1
        CROSS JOIN #Apellidos a2
        ORDER BY NEWID();

        DROP table #Nombres;
        drop table #Apellidos;
    END

    DECLARE  @maxEstudiantexCarrera INT = (SELECT ISNULL(MAX(idEstudiantexCarrera),0) FROM ESTUDIANTEXCARRERA);

    SET @contador = 0;
    WHILE @contador<@cantidadEstudiantexCarrera
    BEGIN   
        INSERT INTO ESTUDIANTEXCARRERA (fechaInicio, idCarrera,codigoEstudiante) VALUES(
        GETDATE(),
        (SELECT TOP 1 idCarrera FROM CARRERAS ORDER BY NEWID()),
        (SELECT TOP 1 codigoEstudiante FROM ESTUDIANTES ORDER BY NEWID())
        );
        SET @contador=@contador +1
    END

    DECLARE @maxGrupo INT = (SELECT ISNULL(MAX(codigoGrupo),0)FROM GRUPOS);

    SET @contador=0;
    WHILE @contador<@cantidadGrupos
    BEGIN
        INSERT INTO GRUPOS (codigoEstudiante,codigoProfesor,idEstudiantexCarrera,idAsignaturaxCarrera) VALUES(
        (SELECT TOP 1 codigoEstudiante FROM ESTUDIANTES ORDER BY NEWID()),
        (SELECT TOP 1 codigoProfesor FROM PROFESORES ORDER BY NEWID()),
        (SELECT TOP 1 idEstudiantexCarrera FROM ESTUDIANTEXCARRERA ORDER BY NEWID()),
        (SELECT TOP 1 idAsignaturaxCarrera FROM ASIGNATURAXCARRERA ORDER BY NEWID())
        );
        SET @contador=@contador+1
    END

    DECLARE @maxEstudiantesxGrupo INT = (SELECT ISNULL(MAX(idEstudiantexGrupo),0)FROM ESTUDIANTEXGRUPO);

    SET @contador=0;
    WHILE @contador<@cantidadEstudiantexGrupo
    BEGIN
        INSERT INTO ESTUDIANTEXGRUPO (definitiva, estado, fecha,codigoGrupo,idEstudiantexCarrera) VALUES(
        ROUND(RAND()*5,1),
        'Matriculado',
        GETDATE(),
        (SELECT TOP 1 codigoGrupo FROM GRUPOS ORDER BY NEWID()),
        (SELECT TOP 1 idEstudiantexCarrera FROM ESTUDIANTEXCARRERA ORDER BY NEWID())
        );
        SET @contador=@contador+1
    END

    DECLARE @maxSalonesxGrupo INT = (SELECT ISNULL(MAX(idSalonxGrupo),0)FROM SALONESXGRUPO);

    SET @contador=0;
    WHILE @contador<@cantidadSalonesxGrupo
    BEGIN
        INSERT INTO SALONESXGRUPO (horario, idSalon, codigoGrupo) VALUES(
        CONCAT('SalonesxGrupo', (@maxSalonesxGrupo+@contador+1)),
        (SELECT TOP 1 idSalon FROM SALONES ORDER BY NEWID()),
        (SELECT TOP 1 codigoGrupo FROM GRUPOS ORDER BY NEWID())
        );
        SET @contador=@contador+1
    END
END

EXEC insercionMasiva 50, 100, 200, 15, 20, 20, 15, 5, 10, 30, 40;


